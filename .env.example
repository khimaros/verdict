# local config. copy to .env at the repo root: the python code loads it --
# the endpoint, the e2e tests and the scripts -- so make serve, make test-e2e
# and make formatters need no arguments and no exports.
#
# plain KEY=value lines. no export prefix, no shell expansions. the
# environment beats the file and command line flags beat both; an empty
# value counts as unset.
#
# .env is ignored and .env.example is not, which is why nothing secret is
# filled in below.

# the llama-server or llama-swap to sit in front of, and the model id behind
# it. these are the same two the e2e tests and make formatters use. the model
# is the one the jev aliases and a request that names none are answered by; a
# request that names another backend model is routed to it. the endpoint
# itself runs without a model, and then every request has to name one.
LLAMA_VERDICT_URL=http://127.0.0.1:8080/v1
LLAMA_VERDICT_MODEL=qwen3.5-9b:Q8_0

# the names an openai-compatible client conventionally reads work too. verdict's
# own names above win wherever they are set, because OPENAI_BASE_URL is often
# exported for some other tool. OPENAI_API_BASE is the older spelling.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_BASE=http://127.0.0.1:8080/v1
# OPENAI_MODEL=qwen3.5-9b:Q8_0

# a bearer key to present to the BACKEND, for one that requires it. verdict's
# own goes wherever verdict is pointed. OPENAI_API_KEY is usually a real key
# for somebody else's service, so it is sent only to the backend that
# OPENAI_BASE_URL or OPENAI_API_BASE names.
# LLAMA_VERDICT_API_KEY=
# OPENAI_API_KEY=

# answer every request with the model above, whatever model it names.
# VERDICT_ROUTING=0

# where the jev endpoint listens. the demos all expect 8477 on loopback.
# VERDICT_HOST=127.0.0.1
# VERDICT_PORT=8477

# required of callers as authorization: bearer <key>. leaving it unset leaves
# the endpoint open, which is fine on loopback and not fine anywhere else.
# VERDICT_API_KEY=local

# pin a formatter instead of deriving one from the model's own chat template.
# derivation costs 30-50 s the first time a template is seen and ~300 ms once
# its hash is cached, so pinning is a convenience rather than a speed win.
# VERDICT_FORMATTER=spec/formatters/qwen3.5-9b_Q8_0.json

# debiasing, both opt-in because each costs extra scoring passes. order
# averaging scores under N option orders (2 = forward and reversed); prior
# correction divides out what the model answers for an empty state.
# VERDICT_ORDER_AVERAGING=2
# VERDICT_PRIOR_CORRECTION=1

# read the bound model with one of spec/layouts, or `chat`, instead of the
# readout verdict's copy of the model registry names for it. a recognised
# model needs none of this.
# VERDICT_LAYOUT=decider-plain

# where make layouts reads the model registry's layout table from, when not
# its published copy: a path or a url to the table as json, such as
# docs/layouts.json in an aimbot checkout. the registry is canonical for
# layouts and spec/layouts is verdict's committed copy.
# VERDICT_LAYOUTS_SOURCE=/path/to/aimbot/docs/layouts.json

# a decision head on disk, for a layout read through one (jev-omni). unset,
# the head the layout pins is fetched once and held to its checksum.
# VERDICT_HEAD=/path/to/decision-head-f32.npz

# a safetensors file on disk holding the output embedding rows a joint head
# (clef-flash) reads. unset, they are read by byte range from the weights the
# layout pins, and each row is kept once fetched.
# VERDICT_HEAD_ROWS=/path/to/model-00001-of-00004.safetensors

# spell out the assistant opening for a format whose generation prompt ends
# before content begins. gpt-oss needs one.
# VERDICT_ASSISTANT_OPEN=<|start|>assistant<|channel|>final<|message|>

# read the spec from somewhere other than ./spec. only useful when trying a
# candidate spec against the conformance fixtures.
# LLAMA_VERDICT_SPEC=/path/to/spec
